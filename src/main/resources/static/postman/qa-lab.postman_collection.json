{"info":{"name":"QA Lab — HTTP practice","_postman_id":"8d37c2a9-706b-4f83-a7f5-qalab","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"Run requests in order. No real payments or personal data."},"variable":[{"key":"baseUrl","value":"http://localhost:8080"},{"key":"token","value":""},{"key":"email","value":"student-{{$timestamp}}@example.test"},{"key":"password","value":"LearnOnly123!"},{"key":"productId","value":""},{"key":"orderId","value":""}],"item":[{"name":"01 Catalog","request":{"method":"GET","url":"{{baseUrl}}/api/catalog"}},{"name":"02 Register","event":[{"listen":"test","script":{"exec":["pm.environment.set('token',pm.response.json().token);","pm.test('201',()=>pm.expect(pm.response.code).to.eql(201));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{email}}\",\"password\":\"{{password}}\",\"name\":\"Postman QA\"}"},"url":"{{baseUrl}}/api/auth/register"}},{"name":"03 Me","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/me"}},{"name":"04 Products","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/products?page=0&size=10"}},{"name":"05 Create product","event":[{"listen":"test","script":{"exec":["pm.environment.set('productId',pm.response.json().id);"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Postman keyboard\",\"price\":1500,\"stock\":7}"},"url":"{{baseUrl}}/api/products"}},{"name":"06 Invalid product 400","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"\",\"price\":-1,\"stock\":7}"},"url":"{{baseUrl}}/api/products"}},{"name":"07 PATCH stock","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"stock\":5}"},"url":"{{baseUrl}}/api/products/{{productId}}"}},{"name":"08 Order","event":[{"listen":"test","script":{"exec":["pm.environment.set('orderId',pm.response.json().id);"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"postman-order-1"}],"body":{"mode":"raw","raw":"{\"productId\":\"{{productId}}\",\"quantity\":2}"},"url":"{{baseUrl}}/api/orders"}},{"name":"09 Declined payment","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"outcome\":\"DECLINED\"}"},"url":"{{baseUrl}}/api/orders/{{orderId}}/pay"}},{"name":"10 Cancel","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/orders/{{orderId}}/cancel"}},{"name":"11 Forbidden admin","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/admin/stats"}},{"name":"12 Reset sandbox","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/sandbox/reset"}}]}
